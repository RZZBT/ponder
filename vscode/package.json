{
  "name": "ponder",
  "displayName": "Ponder",
  "description": "Press Alt+W on a library call to see a short, step-by-step animation of what the function does.",
  "version": "0.2.0",
  "publisher": "RZZBT",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RZZBT/ponder"
  },
  "homepage": "https://github.com/RZZBT/ponder#readme",
  "bugs": {
    "url": "https://github.com/RZZBT/ponder/issues"
  },
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "keywords": [
    "animation",
    "documentation",
    "learn",
    "beginner",
    "visualize",
    "numpy",
    "lodash",
    "python",
    "javascript",
    "java"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode most language extensions are off, so Ponder can only explain why it cannot find animations. The folder's own Ponder settings are ignored.",
      "restrictedConfigurations": [
        "ponder.localFolders"
      ]
    }
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "ponder.open",
        "title": "Open Ponder",
        "category": "Ponder"
      },
      {
        "command": "ponder.copySymbol",
        "title": "Copy Ponder Symbol",
        "category": "Ponder"
      },
      {
        "command": "ponder.clearCache",
        "title": "Clear Cached Animations",
        "category": "Ponder"
      }
    ],
    "keybindings": [
      {
        "command": "ponder.open",
        "key": "alt+w",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ponder.open",
          "group": "navigation@90"
        },
        {
          "command": "ponder.copySymbol",
          "group": "9_cutcopypaste@90"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "ponder.json",
          "**/META-INF/ponder/ponder.json"
        ],
        "url": "./media/ponder.schema.json"
      }
    ],
    "configuration": {
      "title": "Ponder",
      "properties": {
        "ponder.autoplay": {
          "type": "boolean",
          "default": true,
          "description": "Start playing when the animation opens."
        },
        "ponder.reducedMotion": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Follow the operating system setting",
            "Always jump between steps without movement",
            "Always animate"
          ],
          "description": "Reduce motion: steps switch instantly and nothing advances by itself."
        },
        "ponder.onlineLookup": {
          "type": "string",
          "enum": [
            "ask",
            "on",
            "off"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask the first time a library has no animation of its own",
            "Look in the community index when a library has no animation",
            "Never go online"
          ],
          "markdownDescription": "For libraries that ship no `ponder.json`, look for an animation in the community index. Only the package name is sent (for example `pypi/numpy`), never your code. Results are cached for a day and work offline afterwards.",
          "scope": "application"
        },
        "ponder.indexUrl": {
          "type": "string",
          "default": "https://rzzbt.github.io/ponder-index/",
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])[:/])",
          "patternErrorMessage": "Use an https:// address (http:// only for localhost, to test an index on this machine).",
          "description": "Address of the community index.",
          "scope": "application"
        },
        "ponder.localFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra folders with `ponder.json` files you made or downloaded. The `.ponder` folder of each workspace folder is always used."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node build.mjs && node test-integration/run.mjs",
    "package": "node build.mjs && npx --yes @vscode/vsce@3.2.1 package --no-dependencies -o ponder.vsix",
    "test:languages": "node build.mjs && node test-integration/polyglot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.4.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
