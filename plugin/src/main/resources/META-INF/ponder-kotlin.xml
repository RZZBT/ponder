<idea-plugin>
  <!-- Loaded only when the Kotlin plugin is present. Same provider: it resolves through UAST (no K1 compiler APIs). -->
  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.lineMarkerProvider language="kotlin" implementationClass="dev.ponder.ui.PonderLineMarkerProvider"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
  </extensions>
</idea-plugin>
